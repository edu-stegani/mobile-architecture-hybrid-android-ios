{
  "name": "qa-mobile-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:local:android": "cross-env PLATFORM=android wdio run config/wdio.android.emulator.ts",
    "test:local:ios": "cross-env PLATFORM=ios wdio run config/wdio.ios.emulator.ts",

    "test:device:android": "cross-env PLATFORM=android wdio run config/wdio.android.device.ts",
    "test:device:ios": "cross-env PLATFORM=ios wdio run config/wdio.ios.device.ts",

    "test:browserstack:android": "cross-env PLATFORM=android npx wdio run config/wdio.android.browserstack.ts",
    "test:browserstack:ios": "cross-env PLATFORM=ios npx wdio run config/wdio.ios.browserstack.ts",

    "retest:browserstack:android": "cross-env PLATFORM=android npx wdio run config/wdio.android.browserstack.ts --mochaOpts.grep=@reteste",
    "retest:browserstack:ios": "cross-env PLATFORM=ios npx wdio run config/wdio.ios.browserstack.ts --mochaOpts.grep=@reteste",

    "temp:local": "cross-env PLATFORM=android wdio run config/wdio.android.emulator.ts --spec tests/specs/reembolso/reembolso_solicitar_reembolso_informando_dados_bancarios.spec.ts",
    "temp:device": "cross-env PLATFORM=android npx wdio run config/wdio.android.device.ts --spec tests/specs/reembolso/reembolso_solicitar_reembolso_informando_dados_bancarios.spec.ts",
    "temp:bstack": "cross-env PLATFORM=android npx wdio run config/wdio.android.browserstack.ts --spec tests/specs/reembolso/reembolso_solicitar_reembolso_informando_dados_bancarios.spec.ts",

    "report:generate": "npx allure-commandline generate allure-results --clean -o ./allure-report",
    "report:open": "npx allure open allure-report",
    "report:serve": "npx allure serve allure-results",
    "clean:allure": "rimraf allure-results",
    "clean:screenshots": "rimraf screenshots"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@badisi/wdio-harness": "^4.3.1",
    "@testing-library/webdriverio": "^3.2.1",
    "@types/node": "^25.5.2",
    "@types/oracledb": "^6.10.3",
    "@types/pg": "^8.18.0",
    "@wdio/appium-service": "^9.24.0",
    "@wdio/browserstack-service": "^9.24.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "@wdio/visual-service": "^9.1.6",
    "appium-device-farm": "^11.3.2",
    "appium-uiautomator2-driver": "^7.0.0",
    "appium-xcuitest-driver": "^10.24.2",
    "browserstack-local": "^1.5.13",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^5.6.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wdio-wait-for": "^3.1.1",
    "webdriverio": "^9.24.0"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.24.0",
    "appium": "^3.2.0",
    "axios": "^1.15.0",
    "dotenv": "^17.3.1",
    "oracledb": "^6.10.0",
    "pg": "^8.20.0"
  }
}
