{
  "name": "qa-mobile-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:android": "cross-env PLATFORM=android wdio run config/wdio.android.conf.ts",
    "test:ios": "cross-env PLATFORM=ios wdio run config/wdio.ios.conf.ts",
    "temp": "cross-env PLATFORM=android wdio run config/wdio.android.conf.ts --spec receita",
    "test:ios:bstack": "cross-env PLATFORM=ios npx wdio run config/wdio.browserstack.ios.conf.ts",
    "temp:bstack": "cross-env PLATFORM=ios npx wdio run config/wdio.browserstack.ios.conf.ts --spec tests/specs/receita.spec.ts",
    "report:generate": "npx allure generate -o allure-report allure-results",
    "report:open": "npx allure open allure-report",
    "report:serve": "npx allure serve allure-results",
    "clean:allure": "rimraf allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@badisi/wdio-harness": "^4.3.1",
    "@testing-library/webdriverio": "^3.2.1",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@wdio/appium-service": "^9.24.0",
    "@wdio/browserstack-service": "^9.24.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "@wdio/visual-service": "^9.1.6",
    "appium-device-farm": "^11.3.2",
    "appium-uiautomator2-driver": "^7.0.0",
    "appium-xcuitest-driver": "^10.24.2",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^5.6.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wdio-wait-for": "^3.1.1",
    "webdriverio": "^9.24.0"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.24.0",
    "appium": "^3.2.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  }
}
