{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@screens/*": ["./screens/*"]
    },
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "@wdio/appium-service",
      "expect-webdriverio",
      "webdriverio"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "./tests/**/*.ts",
    "./screens/**/*.ts",
    "config/**/*.ts"
  ]
}